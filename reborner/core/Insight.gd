# core/Insight.gd — มาตรวัดประกาย (GDD 4.3)
#
# หลักการเดียวที่ห้ามละเมิด: ทุกแหล่ง Insight คือสถานการณ์ที่กำลังแย่
# ประกายจึงมาถึงตอนกำลังจะแพ้เสมอ ไม่ใช่ตอนเดินฟาร์ม
#
# ⚠ บทเรียน 1: แหล่ง Insight มีสองชนิดที่ต้องแยกให้ขาด
#   crisis  = เหตุการณ์ที่เกิดเป็นครั้งๆ ไม่โตตามความยาวศึก
#   ambient = สะสมทุกเทิร์นแค่เพราะอยู่ในศึก โตเป็นเส้นตรงตามความยาว
#   ถ้า ambient สูงเกิน Insight จะกลายเป็น "นาฬิกาจับเวลาศึก" ไม่ใช่ "มาตรวัดวิกฤต"
#
# ⚠ บทเรียน 2: ศัตรูเล็งตัวที่ HP น้อยที่สุด = มอนร่วมทีมเป็นแท้งก์
#   ตัวเอกแทบไม่โดนตีเลย crisis ที่ผูกกับ HP ของตัวเอกจึงแทบไม่ยิง
#   Insight ต้องตอบสนองต่อความอันตรายของ "ทั้งทีม" ไม่ใช่แค่ตัวเอก
class_name Insight
extends RefCounted

const THRESHOLD := 40.0   # สะสมถึงค่านี้ = ประกายแน่นอน
const CARRY := 0.2        # เศษยกไป 20% ของส่วนเกิน
const LOCK_ROUNDS := 9    # ล็อกการสะสมหลังประกายจาก Insight เต็ม
# Insight ค้างข้ามศึก (kwan เลือก 6 ต.ค. 2026 กันช่วงแห้ง): จบศึกเก็บ Insight ไว้ส่วนนี้ ไปเริ่มศึกถัดไป
# ยังผูกกับสถานการณ์แย่ — ค้างได้เฉพาะที่สะสมจากวิกฤต · ประกายจาก Insight เต็มยังรีเซ็ตเป็น 0 ตามเดิม
## Insight ที่ติดไปศึกถัดไป — ส่วนที่ได้ "ในศึกนี้" คูณ ThreatFactor ของศึกที่เลื่อนสเกลให้ ขั้นต่ำ (0.2) = 0 · สูสีขึ้นไป = 1
## ส่วนที่ค้างมาจากศึกก่อนไม่ถูกหัก (ตีมอนอ่อนไม่ทำให้ของที่สะสมไว้หาย)
## กันฟาร์มมอนอ่อน (kwan เลือก 6 ต.ค. 2026): ค้างคาวคู่ที่ prof 25 ทำคู่หูเจ็บ ~17 Insight/ศึก เต็มทุก 2–3 ศึก ทั้งที่ศัตรูอ่อนกว่ามาก
##   คูณ ThreatFactor ตรงๆ ยังเหลือ 20% ที่ขั้นต่ำ ฟาร์มได้ 2.8 ท่า/100 ศึก · เลื่อนสเกลแล้วเหลือ 0 เท่าไม่ค้าง (GDD 11.33)
## before = Insight ตอนเริ่มศึก · after = ตอนจบ (ถ้าน้อยกว่า before แปลว่าใช้ Insight เต็มไปแล้ว ที่เหลือได้มาในศึกนี้ทั้งหมด)
static func carry(before: float, after: float, enemy_tier: float, prof: float) -> float:
	var f := clampf((Formulas.threat(enemy_tier, prof) - Formulas.THREAT_MIN) / (1.0 - Formulas.THREAT_MIN), 0.0, 1.0)
	var kept := after * f if after < before else before + (after - before) * f
	return kept * CARRY_BATTLE

const CARRY_BATTLE := 1.0   # kwan เลือก 6 ต.ค. 2026 · วัด 0/0.25/0.5/0.75/1: ต่ำกว่า 1 ช่วงแห้งแทบไม่หด (27 ศึก) · 1 = ท่าแรกในบันได 60 ศึก ศึกที่ 26 → 12 (GDD 11.32)
# ประกายครั้งแรกแน่นอน (kwan เลือก 4 ต.ค. 2026 — ศึกภูมิภาค 1 สั้น 3–4 รอบ ตัวเอกใช้ท่า ~1 ครั้ง/ศึก
# วัด 300 เกม × 11 ศึกแรก ได้ประกายแค่ 38% ของเกม): ตัวเอกที่ยังไม่เคยประกาย
# ได้ Insight จากแหล่งไหนก็ตามครั้งแรก = เต็มทันที → ท่าถัดไปประกาย (ยังผูกกับสถานการณ์แย่ตามหลักเดิม)
const FIRST_GLIMMER_SURE := true

# ── crisis: เกิดเป็นครั้งๆ ให้เยอะได้ ──
# ×1.1 ทั้งชุด (6 ต.ค. 2026 · Sim 1000 ศึก): Insight เต็ม ศึกอันตราย 0.01 → 0.10/ศึก · มินิบอส 0.17 → 0.34/ศึก (เป้า ~0.11 / ~0.42)
# ×1.25 เกินเป้า (Insight เต็ม 0.29/ศึกอันตราย) · ×1.5 ชนะพุ่ง 92% (Sim 200 ศึก) ห้ามดันต่อโดยไม่วัด
const ALLY_DOWN      := 19.8  # เพื่อนร่วมทีมล้ม — วิกฤตที่เกิดจริงบ่อยที่สุด
const HP_CRITICAL    := 12.1  # ตัวเอก HP ต่ำกว่า 15%
const GUARD_HIT      := 8.8   # ตั้งรับแล้วถูกโจมตี
const HP_LOW         := 5.5   # ตัวเอก HP ต่ำกว่า 30%
const HEAVY_HIT      := 4.4   # ตัวเอกโดนหนักเกิน 18% maxHP
const ALLY_HURT      := 8.8   # เพื่อนร่วมทีม HP ต่ำกว่า 35%
const GOT_STATUS     := 3.3   # ตัวเอกติดสถานะ

# ── ambient: สะสมทุกเทิร์น ต้องต่ำ ไม่งั้นศึกยาว = ประกายฟรี ──
# บอสคือโรงงานประกายโดยเจตนา — แต่ค่านี้เป็นหน้าผา:
# 9 ได้ 0.30/ศึก · 10 ได้ 0.87/ศึก (บอสทำแค่ ~3 เทิร์นต่อศึก) ขยับทีละ 0.5
const FIGHTING_BOSS  := 9.0   # ต่อเทิร์นของบอส
const STRONGER_FOE   := 1.0   # ต่อเทิร์นของศัตรูที่ tier >= ความชำนาญ
const TECH_ON_STRONG := 1.0   # ใช้ท่ากับศัตรูที่แข็งกว่า
const HIT_WEAKNESS   := 1.0   # ตีจุดอ่อน

const BOSS_TIER := 40         # tier ตั้งแต่นี้นับเป็นบอส
const ALLY_HURT_RATIO := 0.35 # เกณฑ์ "เพื่อนเจ็บหนัก"
