# core/Insight.gd — มาตรวัดประกาย (GDD 4.3)
#
# หลักการเดียวที่ห้ามละเมิด: ทุกแหล่ง Insight คือสถานการณ์ที่กำลังแย่
# ประกายจึงมาถึงตอนกำลังจะแพ้เสมอ ไม่ใช่ตอนเดินฟาร์ม
#
# ⚠ บทเรียน 1: แหล่ง Insight มีสองชนิดที่ต้องแยกให้ขาด
#   crisis  = เหตุการณ์ที่เกิดเป็นครั้งๆ ไม่โตตามความยาวศึก
#   ambient = สะสมทุกเทิร์นแค่เพราะอยู่ในศึก โตเป็นเส้นตรงตามความยาว
#   ถ้า ambient สูงเกิน Insight จะกลายเป็น "นาฬิกาจับเวลาศึก" ไม่ใช่ "มาตรวัดวิกฤต"
#
# ⚠ บทเรียน 2: ศัตรูเล็งตัวที่ HP น้อยที่สุด = มอนร่วมทีมเป็นแท้งก์
#   ตัวเอกแทบไม่โดนตีเลย crisis ที่ผูกกับ HP ของตัวเอกจึงแทบไม่ยิง
#   Insight ต้องตอบสนองต่อความอันตรายของ "ทั้งทีม" ไม่ใช่แค่ตัวเอก
class_name Insight
extends RefCounted

const THRESHOLD := 40.0   # สะสมถึงค่านี้ = ประกายแน่นอน
const CARRY := 0.2        # เศษยกไป 20% ของส่วนเกิน
const LOCK_ROUNDS := 9    # ล็อกการสะสมหลังประกายจาก Insight เต็ม

# ── crisis: เกิดเป็นครั้งๆ ให้เยอะได้ ──
const ALLY_DOWN      := 18.0  # เพื่อนร่วมทีมล้ม — วิกฤตที่เกิดจริงบ่อยที่สุด
const HP_CRITICAL    := 11.0  # ตัวเอก HP ต่ำกว่า 15%
const GUARD_HIT      := 8.0   # ตั้งรับแล้วถูกโจมตี
const HP_LOW         := 5.0   # ตัวเอก HP ต่ำกว่า 30%
const HEAVY_HIT      := 4.0   # ตัวเอกโดนหนักเกิน 18% maxHP
const ALLY_HURT      := 8.0   # เพื่อนร่วมทีม HP ต่ำกว่า 35%
const GOT_STATUS     := 3.0   # ตัวเอกติดสถานะ

# ── ambient: สะสมทุกเทิร์น ต้องต่ำ ไม่งั้นศึกยาว = ประกายฟรี ──
# บอสคือโรงงานประกายโดยเจตนา — แต่ค่านี้เป็นหน้าผา:
# 9 ได้ 0.30/ศึก · 10 ได้ 0.87/ศึก (บอสทำแค่ ~3 เทิร์นต่อศึก) ขยับทีละ 0.5
const FIGHTING_BOSS  := 9.0   # ต่อเทิร์นของบอส
const STRONGER_FOE   := 1.0   # ต่อเทิร์นของศัตรูที่ tier >= ความชำนาญ
const TECH_ON_STRONG := 1.0   # ใช้ท่ากับศัตรูที่แข็งกว่า
const HIT_WEAKNESS   := 1.0   # ตีจุดอ่อน

const BOSS_TIER := 40         # tier ตั้งแต่นี้นับเป็นบอส
const ALLY_HURT_RATIO := 0.35 # เกณฑ์ "เพื่อนเจ็บหนัก"
